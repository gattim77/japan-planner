{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japan-planner",
  "main": "./build/cloudflare-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japan-planner",
      "database_id": "bac4c9a4-df6b-4b40-896d-58644b5f27b4",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    {
      "pattern": "japan-planner.third-ai.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {}
}
